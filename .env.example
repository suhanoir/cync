# Database Connection
# For PostgreSQL (Production / Docker / Cloud):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cync?schema=public"
# For SQLite (Local zero-setup development):
DATABASE_URL="file:./dev.db"

# Authentication Secret (min 32 characters for JOSE / JWT HMAC-SHA256)
AUTH_SECRET="replace-with-a-secure-random-secret-key-at-least-32-chars-long"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

